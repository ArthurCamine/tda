<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="TDA Companion"
    Manufacturer="Faysk"
    Version="$(Version)"
    UpgradeCode="{8C374216-60BB-463C-A716-40B3ED9A4179}"
    Scope="perUser"
    Compressed="yes">

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="Já existe uma versão mais recente do TDA Companion instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="TdaRoot" Name="TDA">
        <Directory Id="CompanionRoot" Name="Companion">
          <Directory Id="VersionsRoot" Name="versions">
            <Directory Id="INSTALLFOLDER" Name="$(Version)" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="TdaProgramsFolder" Name="TDA" />
    </StandardDirectory>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER">
      <File Id="TDACompanionExe" Source="!(bindpath.App)\TDACompanion.exe" KeyPath="yes" />
    </Component>

    <Component Id="MaintenanceExecutable" Directory="INSTALLFOLDER">
      <File Id="TDACompanionMaintenanceExe" Source="!(bindpath.App)\TDACompanionMaintenance.exe" KeyPath="yes" />
    </Component>

    <Binary
      Id="TDACompanionMaintenanceUpgradeBinary"
      SourceFile="!(bindpath.App)\TDACompanionMaintenance.exe" />

    <Component Id="InstalledVersion" Directory="CompanionRoot">
      <File
        Id="CurrentVersionFile"
        Source="!(bindpath.Metadata)\current-version.txt"
        Name="current-version.txt"
        KeyPath="yes" />
    </Component>

    <Component Id="ProductMetadata" Directory="CompanionRoot">
      <RegistryKey
        Root="HKCU"
        Key="Software\Faysk\TDA Companion"
        ForceDeleteOnUninstall="yes">
        <RegistryValue Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Name="Version" Type="string" Value="[ProductVersion]" />
        <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" />
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </RegistryKey>
    </Component>

    <Component Id="StartupRegistration" Directory="INSTALLFOLDER">
      <RegistryValue
        Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Run"
        Name="TDA Companion Agent"
        Type="string"
        Value="&quot;[#TDACompanionExe]&quot; --agent --startup"
        KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="TdaProgramsFolder">
      <Shortcut
        Id="TDACompanionStartMenuShortcut"
        Name="TDA Companion"
        Description="TDA Companion — processamento local"
        Target="[#TDACompanionExe]"
        Arguments="--ui"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveTdaProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Faysk\TDA Companion"
        Name="StartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- $(Version) is a WiX build-time define, deliberately used instead of an
         MSI property so the deferred verification action receives an immutable
         literal target without depending on deferred CustomActionData access. -->
    <CustomAction
      Id="PrepareInstall"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--prepare-major-upgrade --target-version $(Version)"
      Execute="immediate"
      Return="check" />

    <CustomAction
      Id="PrepareExplicitUninstall"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--prepare-explicit-uninstall"
      Execute="immediate"
      Return="check" />

    <CustomAction
      Id="VerifyInstalledTarget"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--verify-installed-target --target-version $(Version)"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <CustomAction
      Id="RollbackInstallationGuard"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--rollback-major-upgrade"
      Execute="rollback"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="CommitInstallationGuard"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--finish-major-upgrade"
      Execute="commit"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="RollbackUninstallGuard"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--rollback-major-upgrade"
      Execute="rollback"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="CommitUninstallGuard"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--finish-major-upgrade"
      Execute="commit"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="PrepareUninstall"
      FileRef="TDACompanionMaintenanceExe"
      ExeCommand="--prepare-uninstall"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <?if $(RollbackProbe) = "1" ?>
    <CustomAction
      Id="RollbackProbeFailure"
      Error="TDA Companion rollback probe: forced upgrade failure." />
    <?endif ?>

    <InstallExecuteSequence>
      <Custom Action="PrepareInstall" Before="InstallInitialize" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="PrepareExplicitUninstall" Before="InstallInitialize" Condition='(REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)' />

      <Custom Action="RollbackInstallationGuard" After="InstallInitialize" Condition='NOT (REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)' />
      <Custom Action="RollbackUninstallGuard" After="InstallInitialize" Condition='(REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)' />

      <?if $(RollbackProbe) = "1" ?>
      <Custom Action="RollbackProbeFailure" After="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <?endif ?>

      <Custom Action="VerifyInstalledTarget" After="InstallFiles" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="PrepareUninstall" Before="RemoveFiles" Condition='(REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)' />

      <Custom Action="CommitInstallationGuard" Before="InstallFinalize" Condition='NOT (REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)' />
      <Custom Action="CommitUninstallGuard" Before="InstallFinalize" Condition='(REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)' />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="TDA Companion" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="MaintenanceExecutable" />
      <ComponentRef Id="InstalledVersion" />
      <ComponentRef Id="ProductMetadata" />
      <ComponentRef Id="StartupRegistration" />
      <ComponentRef Id="StartMenuShortcut" />
      <Files Include="!(bindpath.App)\**" Directory="INSTALLFOLDER">
        <Exclude Files="!(bindpath.App)\TDACompanion.exe" />
        <Exclude Files="!(bindpath.App)\TDACompanionMaintenance.exe" />
      </Files>
    </Feature>
  </Package>
</Wix>
