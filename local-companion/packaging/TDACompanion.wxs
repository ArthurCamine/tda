<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="TDA Companion"
    Manufacturer="Faysk"
    Version="$(Version)"
    UpgradeCode="{8C374216-60BB-463C-A716-40B3ED9A4179}"
    Scope="perUser"
    Compressed="yes">

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="Já existe uma versão mais recente do TDA Companion instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="TdaRoot" Name="TDA">
        <Directory Id="CompanionRoot" Name="Companion">
          <Directory Id="VersionsRoot" Name="versions">
            <Directory Id="INSTALLFOLDER" Name="$(Version)" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="TdaProgramsFolder" Name="TDA" />
    </StandardDirectory>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER">
      <File
        Id="TDACompanionExe"
        Source="!(bindpath.App)\TDACompanion.exe"
        KeyPath="yes" />
    </Component>

    <Component Id="MaintenanceExecutable" Directory="INSTALLFOLDER">
      <File
        Id="TDACompanionMaintenanceExe"
        Source="!(bindpath.App)\TDACompanionMaintenance.exe"
        KeyPath="yes" />
    </Component>

    <!-- A second copy of the maintenance helper lives in the MSI Binary table.
         It can run before RemoveExistingProducts, which is essential when the
         cached MSI for the currently installed version does not know how to stop
         a stale Agent during MajorUpgrade. It is extracted to MSI temporary
         storage and is never considered an installed Companion process. -->
    <Binary
      Id="TDACompanionMaintenanceUpgradeBinary"
      SourceFile="!(bindpath.App)\TDACompanionMaintenance.exe" />

    <Component Id="InstalledVersion" Directory="CompanionRoot">
      <File
        Id="CurrentVersionFile"
        Source="!(bindpath.Metadata)\current-version.txt"
        Name="current-version.txt"
        KeyPath="yes" />
    </Component>

    <Component Id="ProductMetadata" Directory="CompanionRoot">
      <RegistryKey
        Root="HKCU"
        Key="Software\Faysk\TDA Companion"
        ForceDeleteOnUninstall="yes">
        <RegistryValue Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Name="Version" Type="string" Value="[ProductVersion]" />
        <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" />
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </RegistryKey>
    </Component>

    <Component Id="StartupRegistration" Directory="INSTALLFOLDER">
      <RegistryValue
        Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Run"
        Name="TDA Companion Agent"
        Type="string"
        Value="&quot;[#TDACompanionExe]&quot; --agent --startup"
        KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="TdaProgramsFolder">
      <Shortcut
        Id="TDACompanionStartMenuShortcut"
        Name="TDA Companion"
        Description="TDA Companion — processamento local"
        Target="[#TDACompanionExe]"
        Arguments="--ui"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveTdaProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Faysk\TDA Companion"
        Name="StartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- New-package upgrade preparation. This closes the 0.3.x -> new-version
         gap even if the old cached MSI skipped PrepareUninstall during upgrade. -->
    <CustomAction
      Id="PrepareMajorUpgrade"
      BinaryRef="TDACompanionMaintenanceUpgradeBinary"
      ExeCommand="--prepare-uninstall"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <!-- Installed helper used for normal uninstall and, for versions containing
         this contract, also while that product is being removed by a future
         MajorUpgrade. Failure is no longer ignored. -->
    <CustomAction
      Id="PrepareUninstall"
      FileRef="TDACompanionMaintenanceExe"
      ExeCommand="--prepare-uninstall"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <?if $(RollbackProbe) = "1" ?>
    <!-- Test-only Type 19 failure. It is compiled only into the rollback-probe
         MSI and runs after the old product has been removed. Because
         RemoveExistingProducts is inside the transaction, this failure must
         restore the previous product. Production builds pass RollbackProbe=0. -->
    <CustomAction
      Id="RollbackProbeFailure"
      Error="TDA Companion rollback probe: forced upgrade failure." />
    <?endif ?>

    <InstallExecuteSequence>
      <Custom Action="PrepareMajorUpgrade" Before="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="PrepareUninstall" Before="RemoveFiles" Condition='REMOVE="ALL"' />
      <?if $(RollbackProbe) = "1" ?>
      <Custom Action="RollbackProbeFailure" After="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <?endif ?>
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="TDA Companion" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="MaintenanceExecutable" />
      <ComponentRef Id="InstalledVersion" />
      <ComponentRef Id="ProductMetadata" />
      <ComponentRef Id="StartupRegistration" />
      <ComponentRef Id="StartMenuShortcut" />
      <Files Include="!(bindpath.App)\**" Directory="INSTALLFOLDER">
        <Exclude Files="!(bindpath.App)\TDACompanion.exe" />
        <Exclude Files="!(bindpath.App)\TDACompanionMaintenance.exe" />
      </Files>
    </Feature>
  </Package>
</Wix>
