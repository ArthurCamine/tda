# TEMPORÁRIO: habilita o adapter legado, agora protegido por sessão/capability.
# Não substitui a futura mutation atômica da PR #44; deixar false por padrão.
TDA_EDIT_UNSAFE=false
# Feature flag server-side da mídia de entities do Mundo. Manter false até schema/storage do ambiente alvo + smoke controlado estarem validados.
TDA_WORLD_ENTITY_MEDIA_ENABLED=false
